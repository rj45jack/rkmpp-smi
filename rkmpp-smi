#!/usr/bin/env bash
#
# rkmpp-smi - an nvidia-smi-style hardware monitor for Rockchip SoCs.
#
# Focused on the media pipeline: CPU / RAM / GPU / NPU / DMC / RGA plus the
# per-block VPU (MPP) load & utilisation counters exposed by the Rockchip
# vendor kernel.
#
# Dependencies: bash >= 4.4 + awk + coreutils. No ncurses, no python.
#
# Usage:
#   rkmpp-smi [options]
#
# Options:
#   -n, --interval SEC   Refresh interval in seconds   (default: 1)
#   -a, --all            Show all MPP blocks, not only busy ones
#   -o, --once           Print a single frame then exit (script friendly)
#       --no-color       Disable ANSI colours (also honours $NO_COLOR)
#       --color          Force ANSI colours on (e.g. for --once)
#   -V, --version        Show version and exit
#   -h, --help           Show this help
#
# Keys:  q / Ctrl-C  quit
#
# The script runs unprivileged. Root is only needed for the debugfs-only
# counters (RGA, NPU per-core) and to tune /proc/mpp_service/load_interval;
# every other source works as any user and degrades gracefully when missing.

set -o pipefail
shopt -s nullglob
export LC_ALL=C

# ---------------------------------------------------------------------------
# Config: tweak everything here
# ---------------------------------------------------------------------------
INTERVAL=1          # seconds between frames (may be fractional)
BAR_WIDTH=20        # preferred width of the [] progress bars
BAR_MIN=8           # bars shrink to this on very narrow terminals
LBLW=12             # label column width
MAX_WIDTH=120       # cap the layout width on very wide terminals
MIN_WIDTH=48        # floor the layout width (narrower panes wrap)
DEFAULT_WIDTH=80    # assumed width when there is no terminal ($COLUMNS wins)
WARN_PCT=65         # bar colour: >= this is warning
CRIT_PCT=85         # bar colour: >= this is critical
TEMP_WARN=70        # degC
TEMP_CRIT=80        # degC
KEY_POLL_US=100000  # cap on the input wait per frame, so q is noticed even
                    # when frames take longer than --interval to draw
MIN_TAIL=16         # columns kept for the row tail when shrinking the bar

SHOW_ALL=0
ONCE=0
FORCE_COLOR=auto    # auto | always | never

VERSION=1.0.0

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
usage() {
    cat <<'EOF'
rkmpp-smi - Rockchip MPP/hardware monitor

Usage: rkmpp-smi [options]

  -n, --interval SEC   Refresh interval in seconds (default: 1)
  -a, --all            Show all MPP blocks, not only busy ones
  -o, --once           Print a single frame then exit
      --no-color       Disable ANSI colours (also honours $NO_COLOR)
      --color          Force ANSI colours on (e.g. for --once)
  -V, --version        Show version and exit
  -h, --help           Show this help

Keys:  q / Ctrl-C  quit

Runs unprivileged; sudo is only needed for the debugfs-only counters
(RGA, NPU per-core) and /proc/mpp_service/load_interval.
EOF
}

while (($#)); do
    case $1 in
        --interval=*)  INTERVAL=${1#*=}; shift ;;
        -n|--interval)
            [[ $# -ge 2 ]] || { printf 'Missing value for %s\n\n' "$1" >&2; usage >&2; exit 2; }
            INTERVAL=$2; shift 2 ;;
        -a|--all)      SHOW_ALL=1; shift ;;
        -o|--once)     ONCE=1; shift ;;
        --no-color)    FORCE_COLOR=never; shift ;;
        --color)       FORCE_COLOR=always; shift ;;
        -V|--version)  printf 'rkmpp-smi %s\n' "$VERSION"; exit 0 ;;
        -h|--help)     usage; exit 0 ;;
        *) printf 'Unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

[[ $INTERVAL =~ ^[0-9]+([.][0-9]+)?$ ]] || { printf 'Invalid interval: %s\n' "$INTERVAL" >&2; exit 2; }
[[ $INTERVAL =~ [1-9] ]] || { printf 'Invalid interval: %s (must be > 0)\n' "$INTERVAL" >&2; exit 2; }

# ---------------------------------------------------------------------------
# Terminal / colour setup
# ---------------------------------------------------------------------------
INTERACTIVE=0
(( ONCE == 0 )) && [[ -t 1 ]] && INTERACTIVE=1
# Piping a live TUI is never what you want; force single frame when not a tty.
(( ONCE == 0 )) && (( INTERACTIVE == 0 )) && { ONCE=1; printf 'note: stdout is not a tty, running once\n' >&2; }

setup_colors() {
    local use=0
    case $FORCE_COLOR in
        always) use=1 ;;
        never)  use=0 ;;
        auto)   (( INTERACTIVE )) && [[ -z ${NO_COLOR:-} ]] && use=1 ;;
    esac
    if (( use )); then
        C_DEF=$'\e[0m'; C_TIT=$'\e[1;36m'; C_SUB=$'\e[1;34m'
        C_LBL=$'\e[1;37m'; C_VAL=$'\e[1;32m'; C_WRN=$'\e[1;33m'
        C_ERR=$'\e[1;31m'; C_DIM=$'\e[2;37m'
    else
        C_DEF=''; C_TIT=''; C_SUB=''; C_LBL=''
        C_VAL=''; C_WRN=''; C_ERR=''; C_DIM=''
    fi
}
setup_colors

# Sets TERM_COLS (layout width) and BARW (bar width for this layout). The
# tput call is the one deliberate fork; $COLUMNS overrides it (handy for pipes
# and snap-tested windows), and $DEFAULT_WIDTH covers the no-terminal case.
term_cols() {
    local c=''
    if (( INTERACTIVE )) && command -v tput >/dev/null 2>&1; then
        c=$(tput cols 2>/dev/null)
    fi
    [[ $c =~ ^[1-9][0-9]*$ ]] || c=${COLUMNS:-}
    [[ $c =~ ^[1-9][0-9]*$ ]] || c=$DEFAULT_WIDTH
    (( c > MAX_WIDTH )) && c=$MAX_WIDTH
    (( c < MIN_WIDTH )) && c=$MIN_WIDTH
    TERM_COLS=$c

    # Shrink the bar only when needed to keep MIN_TAIL columns for the row
    # tail (frequency / temperature / utilisation) on the widest row.
    BARW=$BAR_WIDTH
    local over=$(( BARW + (2 + LBLW + 1 + 7) + 10 + MIN_TAIL - TERM_COLS ))
    (( over > 0 )) && BARW=$(( BARW - over ))
    (( BARW > BAR_WIDTH )) && BARW=$BAR_WIDTH
    (( BARW < BAR_MIN )) && BARW=$BAR_MIN
}

# ---------------------------------------------------------------------------
# Small formatters. These write a global instead of printing so the per-frame
# path never forks on a command substitution. Call, then read the global.
# ---------------------------------------------------------------------------

# us_to_s sets DURATION to seconds.fraction for a value in microseconds.
us_to_s() { printf -v DURATION '%d.%06d' $(( $1 / 1000000 )) $(( $1 % 1000000 )); }
# now_us prints the current time in microseconds (EPOCHREALTIME when available).
now_us() {
    local t
    if [[ -n ${EPOCHREALTIME:-} ]]; then
        t=${EPOCHREALTIME/./}
        printf '%d' "${t:0:16}"
    else
        printf '%d' $(( $(date +%s) * 1000000 ))
    fi
}

# Sorts SESSION_DEVS (device:count entries) by descending count. The counts
# compare numerically, so core:10 does not sort before core:9.
sort_dev_counts() {
    local -a sorted=()
    local item k
    for item in "${SESSION_DEVS[@]}"; do
        k=0
        while (( k < ${#sorted[@]} )) && (( 10#${sorted[k]#*:} >= 10#${item#*:} )); do (( k++ )); done
        sorted=("${sorted[@]:0:k}" "$item" "${sorted[@]:k}")
    done
    SESSION_DEVS=("${sorted[@]}")
}

# REP = a single char ($1) repeated N ($2) times (O(1), no subshell).
repeat_char() {
    local pad
    printf -v pad '%*s' "$2" ''
    printf -v REP '%s' "${pad// /$1}"
}

# BAR = progress bar for $1 (integer or float percent; empty => N/A).
draw_bar() {
    local pct=$1 s=$BARW val
    val=${pct%%.*}
    if [[ -z $val ]]; then
        repeat_char '.' "$s"
        printf -v BAR '%b[%s] N/A%b' "$C_DIM" "$REP" "$C_DEF"
        return
    fi
    (( val < 0 )) && val=0
    (( val > 100 )) && val=100

    local color=$C_VAL
    if   (( val >= CRIT_PCT )); then color=$C_ERR
    elif (( val >= WARN_PCT )); then color=$C_WRN
    fi

    local filled=$(( val * s / 100 )) on off
    repeat_char '█' "$filled";           on=$REP
    repeat_char '░' "$(( s - filled ))"; off=$REP
    printf -v BAR '%b[%b%s%b%s%b] %3d%%' \
        "$C_DIM" "$color" "$on" "$C_DIM" "$off" "$C_DEF" "$val"
}

# FMT_HZ = human-readable frequency for a value in Hz.
fmt_hz() {
    local hz=$1 mhz
    if [[ ! $hz =~ ^[0-9]+$ ]]; then printf -v FMT_HZ '-'; return; fi
    mhz=$(( hz / 1000000 ))
    if (( mhz >= 1000 )); then
        printf -v FMT_HZ '%d.%02d GHz' $(( mhz / 1000 )) $(( (mhz % 1000) / 10 ))
    else
        printf -v FMT_HZ '%d MHz' "$mhz"
    fi
}

# FMT_HZ_C = compact frequency ("1.8G", "200M") for narrow layouts.
fmt_hz_c() {
    local hz=$1 mhz
    if [[ ! $hz =~ ^[0-9]+$ ]]; then printf -v FMT_HZ_C '-'; return; fi
    mhz=$(( hz / 1000000 ))
    if (( mhz >= 1000 )); then
        printf -v FMT_HZ_C '%d.%dG' $(( mhz / 1000 )) $(( (mhz % 1000) / 100 ))
    else
        printf -v FMT_HZ_C '%dM' "$mhz"
    fi
}

# FMT_KB = human-readable size for a value in KiB.
fmt_kb() {
    local kb=$1
    if (( kb >= 1048576 )); then
        printf -v FMT_KB '%d.%02d GiB' $(( kb / 1048576 )) $(( (kb % 1048576) * 100 / 1048576 ))
    elif (( kb >= 1024 )); then
        printf -v FMT_KB '%d MiB' $(( kb / 1024 ))
    else
        printf -v FMT_KB '%d KiB' "$kb"
    fi
}

# FMT_TEMP = degrees C for millidegrees, or "N/A".
fmt_temp() {
    local m=$1
    if [[ ! $m =~ ^[0-9]+$ ]]; then printf -v FMT_TEMP 'N/A'; return; fi
    printf -v FMT_TEMP '%d.%d' $(( m / 1000 )) $(( (m % 1000) / 100 ))
}

# FMT_T = $1 truncated to $2 display columns (ASCII), ".." appended if cut.
trunc_cols() {
    local s=$1 n=$2
    if (( ${#s} > n )); then
        (( n >= 2 )) && printf -v FMT_T '%s..' "${s:0:$(( n - 2 ))}" || printf -v FMT_T '%s' "${s:0:n}"
    else
        printf -v FMT_T '%s' "$s"
    fi
}

# FMT_UP = compact uptime for a value in seconds.
fmt_uptime() {
    local s=${1%%.*} d h m
    d=$(( s / 86400 )); h=$(( (s % 86400) / 3600 )); m=$(( (s % 3600) / 60 ))
    if   (( d > 0 )); then printf -v FMT_UP '%dd %dh %dm' "$d" "$h" "$m"
    elif (( h > 0 )); then printf -v FMT_UP '%dh %dm' "$h" "$m"
    else printf -v FMT_UP '%dm' "$m"; fi
}

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------

# Sets DEVFREQ_DIR to the first devfreq node whose exported name matches
# regex $1 (matched on . or - boundaries, so "gpu" hits fb000000.gpu-panthor
# but not mygpu).
devfreq_dir() {
    local d n
    DEVFREQ_DIR=''
    for d in /sys/class/devfreq/*/; do
        [[ -r $d/name ]] || continue
        read -r n 2>/dev/null < "$d/name" || continue
        [[ $n =~ (^|[.-])($1)([.-]|$) ]] && { DEVFREQ_DIR=$d; return 0; }
    done
    return 1
}

# devfreq load/freq -> DV_LOAD, DV_FREQ globals
DV_LOAD=''; DV_FREQ=''
read_devfreq() {
    local raw f
    DV_LOAD=''; DV_FREQ=''
    [[ -n $1 && -d $1 ]] || return
    # Frequency from cur_freq: present even when the driver exposes no load
    # (e.g. panfrost GPU on RK3566), where the load file is empty.
    if [[ -r $1/cur_freq ]]; then read -r DV_FREQ 2>/dev/null < "$1/cur_freq"; fi
    [[ -r $1/load ]] || return
    read -r raw 2>/dev/null < "$1/load" || return
    [[ -n $raw ]] || return
    DV_LOAD=${raw%%@*}
    if [[ $raw == *@* ]]; then
        f=${raw#*@}; f=${f%%Hz*}
        [[ -n $f && $f != 0 ]] && DV_FREQ=$f
    fi
}

# Sets TEMP_RAW to millidegrees of the first thermal zone whose type matches
# regex $1 (boundary-matched like devfreq_dir).
read_temp() {
    local z t
    TEMP_RAW=''
    for z in /sys/class/thermal/thermal_zone*/; do
        [[ -r $z/type && -r $z/temp ]] || continue
        read -r t 2>/dev/null < "$z/type" || continue
        if [[ $t =~ (^|[.-])($1)([.-]|$) ]]; then read -r t 2>/dev/null < "$z/temp"; TEMP_RAW=$t; return 0; fi
    done
}

# ---------------------------------------------------------------------------
# Collectors (set globals; no subshells except where noted)
# ---------------------------------------------------------------------------
PREV_TOTAL=0; PREV_IDLE=0
CPU_USAGE=0; CPU_FREQS='-'; CPU_FREQS_C='-'; CPU_TEMP=''; MEM_TOTAL=0
TERM_COLS=$DEFAULT_WIDTH; BARW=$BAR_WIDTH
MEM_USED=0; MEM_PCT=0; MEM_CACHE=0
SWAP_TOTAL=0; SWAP_USED=0
GPU_LOAD=''; GPU_FREQ=''; GPU_TEMP=''
NPU_LOAD=''; NPU_FREQ=''; NPU_TEMP=''; NPU_DETAIL=''
DMC_LOAD=''; DMC_FREQ=''
RGA_LOAD=''
MPP_LABELS=(); MPP_LOADS=(); MPP_UTILS=(); MPP_NOTE=''; MPP_OK=0
SESSION_TOTAL=0; SESSION_DEVS=()

prime_cpu() {
    local _ u n s i io irq sirq steal
    read -r _ u n s i io irq sirq steal _ 2>/dev/null < /proc/stat || return
    PREV_TOTAL=$(( u + n + s + i + io + irq + sirq + steal ))
    PREV_IDLE=$i
}

collect_cpu() {
    local _ u n s i io irq sirq steal total diff
    read -r _ u n s i io irq sirq steal _ 2>/dev/null < /proc/stat || return
    total=$(( u + n + s + i + io + irq + sirq + steal ))
    diff=$(( total - PREV_TOTAL ))
    if (( diff > 0 )); then
        CPU_USAGE=$(( 100 * (diff - (i - PREV_IDLE)) / diff ))
    else
        CPU_USAGE=0
    fi
    PREV_TOTAL=$total; PREV_IDLE=$i

    local p f out='' out_c='' pol
    for p in /sys/devices/system/cpu/cpufreq/policy*/; do
        [[ -r $p/scaling_cur_freq ]] || continue
        read -r f 2>/dev/null < "$p/scaling_cur_freq" || continue
        [[ $p =~ policy([0-9]+)/ ]] && pol=${BASH_REMATCH[1]} || pol=${p#*policy}
        fmt_hz   "$(( f * 1000 ))"                      # cpufreq is in kHz
        out+="${out:+, }L${pol} $FMT_HZ"                # full, for wide layouts
        fmt_hz_c "$(( f * 1000 ))"
        out_c+="${out_c:+, }L${pol} $FMT_HZ_C"          # compact, for narrow ones
    done
    CPU_FREQS=${out:--}
    CPU_FREQS_C=${out_c:--}

    read_temp 'soc|cpu'; CPU_TEMP=$TEMP_RAW
}

collect_mem() {
    local key val total avail free cache
    total=0; avail=0; free=0; cache=0
    while read -r key val _; do
        case $key in
            MemTotal:)    total=$val ;;
            MemAvailable:) avail=$val ;;
            MemFree:)     free=$val ;;
            Cached:)      cache=$val ;;
            SwapTotal:)   SWAP_TOTAL=$val ;;
            SwapFree:)    SWAP_USED=$(( SWAP_TOTAL - val )) ;;
        esac
    done < /proc/meminfo
    MEM_TOTAL=$total
    MEM_CACHE=$cache
    [[ $avail -eq 0 ]] && avail=$free
    MEM_USED=$(( total - avail ))
    if (( total > 0 )); then MEM_PCT=$(( 100 * MEM_USED / total )); else MEM_PCT=0; fi
}

collect_accel() {
    GPU_LOAD=''; GPU_FREQ=''
    if devfreq_dir 'gpu'; then read_devfreq "$DEVFREQ_DIR"; GPU_LOAD=$DV_LOAD; GPU_FREQ=$DV_FREQ; fi
    read_temp 'gpu-thermal|gpu'; GPU_TEMP=$TEMP_RAW

    # NPU: the devfreq "load" value is the rknpu_ondemand governor's request
    # (it pins at 100 while active) and is not utilisation. Prefer the kernel's
    # per-core counters from debugfs when readable (root); fall back to devfreq.
    # Format: "NPU load:  Core0: 28%, Core1:  3%, Core2:  4%,"
    NPU_LOAD=''; NPU_FREQ=''; NPU_DETAIL=''
    local npu_dev_load=''
    if devfreq_dir 'npu'; then
        read_devfreq "$DEVFREQ_DIR"; npu_dev_load=$DV_LOAD; NPU_FREQ=$DV_FREQ
    fi

    local nf=/sys/kernel/debug/rknpu/load nline v max=-1
    local -a cores=()
    if [[ -r $nf ]] && read -r nline < "$nf"; then
        while [[ $nline =~ Core([0-9]+):[[:space:]]*([0-9]+)% ]]; do
            v=${BASH_REMATCH[2]}
            cores+=("$v")
            (( v > max )) && max=$v
            nline=${nline/"${BASH_REMATCH[0]}"/}
        done
    fi
    if (( max >= 0 )); then
        NPU_LOAD=$max
        local saveifs=$IFS; IFS=/
        NPU_DETAIL="cores ${cores[*]}"
        IFS=$saveifs
    elif [[ -n $npu_dev_load ]]; then
        # debugfs unreadable: show the devfreq value, flagged as such
        NPU_LOAD=$npu_dev_load
        NPU_DETAIL='devfreq'
    fi
    read_temp 'npu'; NPU_TEMP=$TEMP_RAW

    DMC_LOAD=''; DMC_FREQ=''
    if devfreq_dir 'dmc'; then read_devfreq "$DEVFREQ_DIR"; DMC_LOAD=$DV_LOAD; DMC_FREQ=$DV_FREQ; fi

    # RGA only exposes its counters through debugfs -> root only.
    # The file lists one entry per scheduler (e.g. 2x rga3 + 1x rga2); report
    # the busiest one so a single saturated unit is not hidden by idle peers.
    RGA_LOAD=''
    local f=/sys/kernel/debug/rkrga/load line v max=-1
    if [[ -r $f ]]; then
        while IFS= read -r line; do
            [[ $line =~ load[[:space:]]*=[[:space:]]*([0-9]+) ]] || continue
            v=${BASH_REMATCH[1]}
            (( v > max )) && max=$v
        done < "$f"
        (( max >= 0 )) && RGA_LOAD=$max
    fi
}

collect_mpp() {
    MPP_LABELS=(); MPP_LOADS=(); MPP_UTILS=(); MPP_NOTE=''; MPP_OK=1
    local f=/proc/mpp_service/load line dev nm
    [[ -r $f ]] || { MPP_OK=0; return; }

    local -a names=() loads=() utils=()
    local load util saw_li=0
    while IFS= read -r line; do
        [[ ${line,,} == *load_interval* ]] && saw_li=1
        # "<addr>.<name>   load:  N.NN%[ utilization:  N.NN%]" - the utilisation
        # field is absent on some older vendor kernels, so it is optional.
        [[ $line =~ ^([^[:space:]]+)[[:space:]]+load:[[:space:]]+([0-9.]+)% ]] || continue
        dev=${BASH_REMATCH[1]}; nm=${dev#*.}; load=${BASH_REMATCH[2]}
        util=''
        [[ $line =~ utilization:[[:space:]]*([0-9.]+)% ]] && util=${BASH_REMATCH[1]}
        names+=("$nm"); loads+=("$load"); utils+=("$util")
    done < "$f"

    # Some kernels (RK3566) refuse to report until the sampling window is set,
    # emitting "please set load_interval first!!!" instead of block lines.
    if (( ${#names[@]} == 0 && saw_li )); then
        MPP_NOTE='load_interval not set in the kernel - run as root to set it'
    fi

    # Number duplicated core names (rkvenc-core, jpege-core, ...) for clarity.
    local -A cnt=() seen=()
    local n i
    for n in "${names[@]}"; do cnt[$n]=$(( ${cnt[$n]:-0} + 1 )); done
    for (( i=0; i<${#names[@]}; i++ )); do
        n=${names[i]}
        if (( ${cnt[$n]:-0} > 1 )); then
            MPP_LABELS+=("${n}[${seen[$n]:-0}]")
            seen[$n]=$(( ${seen[$n]:-0} + 1 ))
        else
            MPP_LABELS+=("$n")
        fi
        MPP_LOADS+=("${loads[i]}")
        MPP_UTILS+=("${utils[i]}")
    done
    return 0
}

collect_sessions() {
    SESSION_TOTAL=0; SESSION_DEVS=()
    local f=/proc/mpp_service/sessions-summary line dev
    [[ -r $f ]] || return
    local -A cnt=()
    while IFS= read -r line; do
        if [[ $line =~ device:[[:space:]]*([^[:space:]]+) ]]; then
            dev=${BASH_REMATCH[1]}; dev=${dev#*.}    # strip "fdc38100." prefix
            cnt[$dev]=$(( ${cnt[$dev]:-0} + 1 ))
            SESSION_TOTAL=$(( SESSION_TOTAL + 1 ))
        fi
    done < "$f"
    for dev in "${!cnt[@]}"; do SESSION_DEVS+=("$dev:${cnt[$dev]}"); done
    # In-place insertion sort by descending count: the associative-array order
    # is arbitrary and the list is tiny, so a hand-rolled sort beats forking
    # `sort` every frame.
    sort_dev_counts
}

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
pick_temp_color() {
    local t=${1%%.*}
    TC=$C_VAL
    [[ $t =~ ^[0-9]+$ ]] || { TC=$C_DIM; return; }
    if   (( t >= TEMP_CRIT )); then TC=$C_ERR
    elif (( t >= TEMP_WARN )); then TC=$C_WRN
    fi
}

# One accelerator row: label, load, freq (Hz, optional), temp (mdegC, optional),
# extra (optional). Optional pieces are dropped if the row would overflow.
accel_row() {
    local label=$1 load=$2 hz=$3 temp=$4 extra=${5:-}
    draw_bar "$load"
    printf '  %b%-*s%b %s' "$C_LBL" "$LBLW" "$label" "$C_DEF" "$BAR"
    local used=$(( 2 + LBLW + 1 + BARW + 7 ))
    if [[ -n $hz ]]; then
        fmt_hz "$hz"
        if (( used + 2 + 10 <= TERM_COLS )); then
            printf '  %b%*s%b' "$C_DIM" 10 "$FMT_HZ" "$C_DEF"; used=$(( used + 12 ))
        fi
    fi
    if [[ -n $extra ]]; then
        if (( used + 2 + ${#extra} <= TERM_COLS )); then
            printf '  %b%s%b' "$C_DIM" "$extra" "$C_DEF"; used=$(( used + 2 + ${#extra} ))
        fi
    fi
    if [[ -n $temp ]]; then
        pick_temp_color "$temp"
        fmt_temp "$temp"
        if (( used + 2 + ${#FMT_TEMP} + 2 <= TERM_COLS )); then
            printf '  %b%s°C%b' "$TC" "$FMT_TEMP" "$C_DEF"
        fi
    fi
    printf '\n'
}

render() {
    local rule up now i s load shown used rulew freqs
    term_cols
    rulew=$TERM_COLS
    repeat_char '─' "$rulew"; rule=$REP
    read -r up _ < /proc/uptime
    printf -v now '%(%H:%M:%S)T' -1

    (( INTERACTIVE )) && printf '\e[H'

    # Header. Trimmed to the layout width so a long board name cannot wrap it.
    fmt_uptime "$up"
    local hb=$BOARD room
    (( ${#hb} + 2 >= TERM_COLS )) && hb="${hb:0:$(( TERM_COLS - 1 ))}"
    room=$(( TERM_COLS - ${#hb} - 2 ))
    local hrest="$SOC  $now up $FMT_UP"
    (( ${#hrest} > room )) && hrest="${hrest:0:room}"
    printf '%b%s%b  %b%s%b\n' "$C_TIT" "$hb" "$C_DEF" "$C_DIM" "$hrest" "$C_DEF"
    printf '%b%s%b\n' "$C_SUB" "$rule" "$C_DEF"

    # CPU. The freq list (and the temperature) are fitted to the row width:
    # full units when there is room, then compact, then truncated. Measured
    # fields stay ASCII because LC_ALL=C counts bytes, not columns, for
    # ${#..}/printf widths; °C is counted as the extra 2 ASCII columns it draws.
    draw_bar "$CPU_USAGE"
    printf '  %b%-*s%b %s' "$C_LBL" "$LBLW" "CPU" "$C_DEF" "$BAR"
    used=$(( 2 + LBLW + 1 + BARW + 7 ))
    local tstr='' tres=0
    if [[ -n $CPU_TEMP ]]; then
        pick_temp_color "$CPU_TEMP"; fmt_temp "$CPU_TEMP"
        tstr="${FMT_TEMP}°C"; tres=$(( 2 + ${#FMT_TEMP} + 2 ))
    fi
    local fbudget=$(( TERM_COLS - used - 2 - tres ))
    local fw=$fbudget; (( fw > 44 )) && fw=44
    if (( fbudget >= 6 )); then
        freqs=$CPU_FREQS
        (( ${#freqs} > fbudget )) && freqs=$CPU_FREQS_C
        (( ${#freqs} > fbudget )) && freqs="${freqs:0:$(( fbudget - 2 ))}.."
        printf '  %b%-*s%b' "$C_DIM" "$fw" "$freqs" "$C_DEF"
    fi
    (( tres )) && printf '  %b%s%b' "$TC" "$tstr" "$C_DEF"
    printf '\n'

    # Memory. "used" is non-reclaimable (MemTotal - MemAvailable); the cache
    # line is the reclaimable page cache that MemAvailable already credits back.
    # The used/total text drops to a compact form on narrow terminals.
    draw_bar "$MEM_PCT"; fmt_kb "$MEM_USED"; used=$FMT_KB; fmt_kb "$MEM_TOTAL"
    trunc_cols "used $used / $FMT_KB" $(( TERM_COLS - (2 + LBLW + 1 + BARW + 7) - 2 )); local mtext=$FMT_T
    printf '  %b%-*s%b %s  %b%s%b\n' "$C_LBL" "$LBLW" "Mem" "$C_DEF" \
        "$BAR" "$C_DIM" "$mtext" "$C_DEF"
    if (( MEM_CACHE > 0 )); then
        fmt_kb "$MEM_CACHE"
        printf '  %b%-*s%b %bcache %s (recl)%b\n' "$C_LBL" "$LBLW" "" "$C_DEF" \
            "$C_DIM" "$FMT_KB" "$C_DEF"
    fi
    if (( SWAP_TOTAL > 0 )); then
        fmt_kb "$SWAP_USED"; used=$FMT_KB; fmt_kb "$SWAP_TOTAL"
        printf '  %b%-*s%b %bswap %s / %s%b\n' "$C_LBL" "$LBLW" "" "$C_DEF" \
            "$C_DIM" "$used" "$FMT_KB" "$C_DEF"
    fi

    printf '%b%s%b\n' "$C_SUB" "$rule" "$C_DEF"

    # Accelerators. Only draw a row when the SoC exposes something for it, so
    # boards without a DMC/NPU node do not show permanent N/A rows.
    [[ -n $GPU_LOAD || -n $GPU_FREQ ]] && \
        accel_row "GPU" "$GPU_LOAD" "$GPU_FREQ" "$GPU_TEMP"
    [[ -n $NPU_LOAD || -n $NPU_FREQ || -n $NPU_TEMP ]] && \
        accel_row "NPU" "$NPU_LOAD" "$NPU_FREQ" "$NPU_TEMP" "$NPU_DETAIL"
    [[ -n $DMC_LOAD || -n $DMC_FREQ ]] && \
        accel_row "DMC" "$DMC_LOAD" "$DMC_FREQ" ""
    if [[ -n $RGA_LOAD ]]; then
        accel_row "RGA" "$RGA_LOAD" "" ""
    elif [[ -r /sys/kernel/debug/rkrga/load ]]; then
        # Readable but no parsable value: keep the row empty rather than guess.
        :
    elif (( EUID == 0 )); then
        printf '  %b%-*s%b %b%s%b\n' "$C_LBL" "$LBLW" "RGA" "$C_DEF" "$C_DIM" "n/a (no rkrga)" "$C_DEF"
    else
        printf '  %b%-*s%b %b%s%b\n' "$C_LBL" "$LBLW" "RGA" "$C_DEF" "$C_DIM" "n/a (needs root)" "$C_DEF"
    fi

    printf '%b%s%b\n' "$C_SUB" "$rule" "$C_DEF"

    # VPU / MPP blocks
    printf '  %b%s%b\n' "$C_LBL" "VPU / MPP blocks" "$C_DEF"
    if (( MPP_OK == 0 )); then
        trunc_cols 'MPP stats unavailable (/proc/mpp_service/load)' $(( TERM_COLS - 5 ))
        printf '     %b%s%b\n' "$C_ERR" "$FMT_T" "$C_DEF"
    elif [[ -n $MPP_NOTE ]]; then
        trunc_cols "$MPP_NOTE" $(( TERM_COLS - 5 ))
        printf '     %b%s%b\n' "$C_WRN" "$FMT_T" "$C_DEF"
    else
        shown=0
        for (( i=0; i<${#MPP_LABELS[@]}; i++ )); do
            load=${MPP_LOADS[i]}
            if (( SHOW_ALL == 0 )) && (( ${load%%.*} == 0 )); then continue; fi
            draw_bar "$load"
            printf '     %b%-*s%b %s' \
                "$C_LBL" 14 "${MPP_LABELS[i]}" "$C_DEF" "$BAR"
            used=$(( 5 + 14 + 1 + BARW + 7 ))
            if [[ -n ${MPP_UTILS[i]} ]]; then
                local u="util ${MPP_UTILS[i]}%"
                (( used + 2 + ${#u} <= TERM_COLS )) && \
                    printf '  %b%s%b' "$C_DIM" "$u" "$C_DEF"
            fi
            printf '\n'
            shown=$(( shown + 1 ))
        done
        if (( shown == 0 )); then
            printf '     %bAll blocks idle%b\n' "$C_DIM" "$C_DEF"
        fi
    fi

    # MPP sessions (open decoder/encoder handles)
    if (( SESSION_TOTAL > 0 )); then
        printf '%b%s%b\n' "$C_SUB" "$rule" "$C_DEF"
        printf '  %b%-*s%b %b%d active%b\n' "$C_LBL" "$LBLW" "MPP sess" "$C_DEF" "$C_DIM" "$SESSION_TOTAL" "$C_DEF"
        for s in "${SESSION_DEVS[@]}"; do
            printf '     %b%s%b\n' "$C_DIM" "$s" "$C_DEF"
        done
    fi

    (( INTERACTIVE )) && printf '\e[J'
}

# ---------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------
SAVED_INTERVAL=''
cleanup() {
    (( INTERACTIVE )) && printf '\e[?25h'
    if [[ -n $SAVED_INTERVAL && -w /proc/mpp_service/load_interval ]]; then
        printf '%s\n' "$SAVED_INTERVAL" > /proc/mpp_service/load_interval 2>/dev/null
    fi
    return 0
}

# Everything below is the runnable program: side effects (traps, reading
# /proc/device-tree, writing load_interval) and the main loop. Guarded so
# `source rkmpp-smi` from tests/run.sh only defines functions and globals.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
    return 0
fi

trap 'exit 0' INT TERM
trap cleanup EXIT

BOARD=$(tr -d '\0' 2>/dev/null < /proc/device-tree/model)
[[ -z $BOARD ]] && BOARD="Rockchip Device"
SOC=''
while IFS= read -r c; do
    case $c in rockchip,*) SOC=$c; break ;; esac
done < <(tr '\0' '\n' 2>/dev/null < /proc/device-tree/compatible)
[[ -z $SOC ]] && SOC=$(tr '\0' '\n' 2>/dev/null < /proc/device-tree/compatible | head -n 1)
[[ -z $SOC ]] && SOC="unknown"

# Align the MPP sampling window with our refresh rate (root only).
INTERVAL_MS=$(awk -v i="$INTERVAL" 'BEGIN { printf "%d", i * 1000 }')
if [[ -w /proc/mpp_service/load_interval ]]; then
    read -r SAVED_INTERVAL 2>/dev/null < /proc/mpp_service/load_interval
    printf '%s\n' "$INTERVAL_MS" > /proc/mpp_service/load_interval 2>/dev/null
fi

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
prime_cpu
sleep 0.2

collect_all() {
    collect_cpu
    collect_mem
    collect_accel
    collect_mpp
    collect_sessions
}

(( INTERACTIVE )) && printf '\e[?25l\e[2J'

if (( ONCE )); then
    collect_all
    render
    exit 0
fi

INTERVAL_US=$(awk -v i="$INTERVAL" 'BEGIN { printf "%d", i * 1000000 }')
next_us=$(now_us)

while :; do
    collect_all
    render

    next_us=$(( next_us + INTERVAL_US ))
    rem=$(( next_us - $(now_us) ))
    (( rem < 0 )) && { rem=0; next_us=$(now_us); }

    # Always poll for q, but wait at most KEY_POLL_US so a keypress is noticed
    # even when a frame takes longer than --interval to collect and draw.
    wait_us=$rem
    (( wait_us > KEY_POLL_US )) && wait_us=$KEY_POLL_US
    (( wait_us > 0 )) && {
        us_to_s "$wait_us"
        if read -t "$DURATION" -rsn1 key; then
            [[ $key == q || $key == Q ]] && break
        fi
    }
    # Sleep out whatever is left of the interval after the poll.
    rem=$(( next_us - $(now_us) ))
    (( rem > 0 )) && { us_to_s "$rem"; sleep "$DURATION"; }
done
